# Copy to .env to override defaults (lab only — never for production).
# Compose reads .env automatically.

# secure | vulnerable  — switches the application security posture
APP_MODE=secure

# HS256 signing secret. Leave empty to auto-generate a strong key at boot.
SECRET_KEY=

# Access token lifetime in minutes (secure default: 30).
TOKEN_EXPIRE_MINUTES=30

# Allowed CORS origins (comma separated).
CORS_ORIGINS=http://localhost:8080,http://localhost,http://127.0.0.1:8080